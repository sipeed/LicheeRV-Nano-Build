            i2ctransfer -y "$BUS" w129@"$ADDR" 0x40 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 2>/dev/null || return 1
            i2ctransfer -y "$BUS" w129@"$ADDR" 0x40 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 2>/dev/null || return 1
            send 0xaf
        }

        # OLED 在 i2c-5（GPIO 模拟），开机需要先把引脚复用、复位脚拉高、加载 i2c-gpio。
        [ -d /sys/class/gpio/gpio502 ] || echo 502 > /sys/class/gpio/export 2>/dev/null
        echo out > /sys/class/gpio/gpio502/direction 2>/dev/null
        echo 1 > /sys/class/gpio/gpio502/value 2>/dev/null
        [ -e /sys/kernel/debug ] || mount -t debugfs none /sys/kernel/debug 2>/dev/null
        if [ ! -e /dev/i2c-5 ]; then
            devmem 0x0300103C 32 0x3 2>/dev/null
            devmem 0x03001050 32 0x3 2>/dev/null
            devmem 0x0300105C 32 0x3 2>/dev/null
            devmem 0x03001060 32 0x3 2>/dev/null
            devmem 0x03001054 32 0x3 2>/dev/null
            devmem 0x03001058 32 0x3 2>/dev/null
            insmod /mnt/system/ko/i2c-algo-bit.ko 2>/dev/null
            insmod /mnt/system/ko/i2c-gpio.ko 2>/dev/null
            sleep 0.2
        fi

        tries=0
        while [ $tries -lt 10 ]; do
            for combo in "5 0x3c" "1 0x3d" "5 0x3d" "1 0x3c"; do
                set -- $combo
                draw "$1" "$2" && exit 0
            done
            tries=$((tries + 1))
            sleep 0.3
        done
        echo "oled: $SCREEN screen failed" >&2
        ;;
esac
exit 0
