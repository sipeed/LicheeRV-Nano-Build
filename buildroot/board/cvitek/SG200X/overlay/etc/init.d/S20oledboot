#!/bin/sh
# 基础镜像（尚未安装 app）开机在 OLED 上显示产测标识；装 app 后由 app 接管。
# 画面数据直接内联，镜像里不再需要 /opt 数据目录。
SCREEN=boot

case "$1" in
    start)
        [ -e /boot/disable_oled_logo ] && exit 0
        [ -d /kvmapp ] && exit 0

        send() { i2ctransfer -y "$BUS" w2@"$ADDR" 0x00 "$1" 2>/dev/null; }
        send2() { i2ctransfer -y "$BUS" w3@"$ADDR" 0x00 "$1" "$2" 2>/dev/null; }
        send3() { i2ctransfer -y "$BUS" w4@"$ADDR" 0x00 "$1" "$2" "$3" 2>/dev/null; }

        draw() {
            BUS=$1
            ADDR=$2
            send 0xae && send2 0xd5 0x80 && send2 0xa8 0x3f && send2 0xd3 0x00 && send 0x40 &&
                send2 0x8d 0x14 && send2 0x20 0x00 && send 0xa1 && send 0xc8 && send2 0xda 0x12 &&
                send2 0x81 0xcf && send2 0xd9 0xf1 && send2 0xdb 0x40 && send 0xa4 && send 0xa6 ||
                return 1
            send3 0x21 0x00 0x7f && send3 0x22 0x00 0x07 || return 1
