            i2ctransfer -y "$BUS" w129@"$ADDR" 0x40 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x03 0x03 0x00 0x00 0x00 0x00 0x03 0x03 0x03 0x03 0x00 0x00 0x00 0x00 0x03 0x03 0x03 0x03 0x03 0x03 0x03 0x03 0x00 0x00 0x00 0x00 0x03 0x03 0x00 0x00 0x00 0x00 0x00 0x00 0x03 0x03 0x00 0x00 0x00 0x00 0x00 0x00 0x03 0x03 0x03 0x03 0x03 0x03 0x00 0x00 0x00 0x00 0x00 0x00 0x03 0x03 0x00 0x00 0x00 0x00 0x00 0x00 0x03 0x03 0x00 0x00 0x00 0x00 0x00 0x00 0x03 0x03 0x00 0x00 0x00 0x00 0x00 0x00 0x03 0x03 0x00 0x00 0x00 0x00 0x03 0x03 0x00 0x00 0x00 0x00 0x03 0x03 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 2>/dev/null || return 1
            i2ctransfer -y "$BUS" w129@"$ADDR" 0x40 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0xff 0x11 0x11 0x11 0x01 0x80 0x78 0x16 0x13 0x1c 0xe0 0x00 0x3c 0xc2 0x81 0x81 0x81 0x66 0x00 0x00 0x01 0x01 0xff 0x01 0x01 0x00 0x3c 0x42 0x81 0x81 0x81 0x42 0x3c 0x00 0x00 0xff 0x11 0x11 0x31 0xee 0x00 0x00 0x03 0x0c 0xf0 0x0c 0x03 0x00 0x00 0x00 0x01 0x01 0xff 0x01 0x01 0x00 0xff 0x91 0x91 0x91 0x81 0x00 0x46 0x89 0x91 0x91 0x72 0x00 0x00 0x01 0x01 0xff 0x01 0x01 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 2>/dev/null || return 1
            i2ctransfer -y "$BUS" w129@"$ADDR" 0x40 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0xf0 0x10 0x10 0x90 0x60 0x00 0x00 0xc0 0x20 0x10 0x10 0x10 0x20 0xc0 0x00 0x00 0xc0 0x20 0x10 0x10 0x10 0x20 0xc0 0x00 0x00 0x10 0x10 0xf0 0x10 0x10 0x00 0xf0 0x00 0x00 0xf0 0x70 0x80 0x00 0xf0 0x00 0x00 0xc0 0x20 0x10 0x10 0x30 0x60 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 2>/dev/null || return 1
